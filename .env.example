# Copy to backend/.env (local dev) or .env (docker compose)

# Generate a long random value for every deployed environment (never reuse this example).
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:5173

# SMTP is required for password-reset emails. Keep credentials private.
# Free test inbox: https://ethereal.email/
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Free key: https://openalex.org/settings/api
# Leave empty to run entirely on the bundled dataset (Toronto / Amsterdam / TU Munich).
OPENALEX_API_KEY=

# Optional LLM for AI email drafts — any OpenAI-compatible endpoint.
# OpenAI:     https://platform.openai.com/api-keys        base https://api.openai.com/v1
# DeepSeek:   https://platform.deepseek.com/api_keys      base https://api.deepseek.com/v1
# OpenRouter: https://openrouter.ai/keys                  base https://openrouter.ai/api/v1
# Groq:       https://console.groq.com/keys               base https://api.groq.com/openai/v1
# Ollama:     no key needed                               base http://localhost:11434/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# sqlite is fine locally; docker compose overrides this with PostgreSQL
DATABASE_URL=sqlite:///./gradmatch.db

# tfidf = offline baseline, sbert = Sentence Transformers (pip install -r backend/requirements-sbert.txt)
EMBEDDING_BACKEND=tfidf
HYBRID_ALPHA=0.6

# Offline demo mode: seed data/raw and rank local candidates when no key is configured
DEMO_MODE=true
AUTO_SEED_DEMO=true

# Protects your OpenAlex credit budget
MAX_UNIVERSITIES_PER_RUN=5
MAX_CANDIDATES_PER_UNIVERSITY=25
CACHE_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
